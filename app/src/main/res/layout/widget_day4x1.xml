<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:padding="@dimen/widget_margin"
    android:background="?attr/colorPrimaryContainer"
    android:theme="@style/Theme.Material3.DynamicColors.DayNight">

  <!-- Date -->
  <TextView
      android:id="@+id/tvDate"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1.2"
      android:fontFamily="@font/jetbrains_mono"
      android:gravity="center"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:text="@null"
      android:textColor="?attr/colorOnPrimaryContainer"
      android:autoSizeTextType="uniform"
      android:autoSizeMinTextSize="7dp"
      android:autoSizeMaxTextSize="12dp"
      android:autoSizeStepGranularity="1dp" />

  <!-- Ligne 1 : Matin / Pause -->
  <LinearLayout
      android:id="@+id/ll1"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="horizontal"
      android:baselineAligned="false">

    <TextView
        android:id="@+id/tvLblMorning"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="center_vertical|start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/tv_morning_widget"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="5dp"
        android:autoSizeMaxTextSize="8dp"
        android:autoSizeStepGranularity="1dp" />

    <TextView
        android:id="@+id/tvMorning"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="center_vertical|start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@null"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="5dp"
        android:autoSizeMaxTextSize="8dp"
        android:autoSizeStepGranularity="1dp" />

    <TextView
        android:id="@+id/tvLblBreak"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="center_vertical|start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/tv_break_widget"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="5dp"
        android:autoSizeMaxTextSize="8dp"
        android:autoSizeStepGranularity="1dp" />

    <TextView
        android:id="@+id/tvBreak"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="center_vertical|start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@null"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="5dp"
        android:autoSizeMaxTextSize="8dp"
        android:autoSizeStepGranularity="1dp" />
  </LinearLayout>

  <!-- Ligne 2 : Après-midi / Total -->
  <LinearLayout
      android:id="@+id/ll2"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:orientation="horizontal"
      android:baselineAligned="false">

    <TextView
        android:id="@+id/tvLblAfternoon"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="center_vertical|start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/tv_afternoon_widget"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="5dp"
        android:autoSizeMaxTextSize="8dp"
        android:autoSizeStepGranularity="1dp" />

    <TextView
        android:id="@+id/tvAfternoon"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="3"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="center_vertical|start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@null"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="5dp"
        android:autoSizeMaxTextSize="8dp"
        android:autoSizeStepGranularity="1dp" />

    <TextView
        android:id="@+id/tvLblWorkTime"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="center_vertical|start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/tv_work_time_widget"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="5dp"
        android:autoSizeMaxTextSize="8dp"
        android:autoSizeStepGranularity="1dp" />

    <TextView
        android:id="@+id/tvWorkTime"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="center_vertical|start"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@null"
        android:textColor="?attr/colorOnPrimaryContainer"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="5dp"
        android:autoSizeMaxTextSize="8dp"
        android:autoSizeStepGranularity="1dp" />
  </LinearLayout>

</LinearLayout>